// Prisma Schema for Reimbursement Management System
// Tables: companies, departments, users, expense_categories, expenses, expense_lines,
//         receipts, expense_comments, approval_rules, approval_rule_approvers,
//         approval_steps, notifications, audit_log

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// COMPANY & ORGANIZATION
// ============================================================================

model Company {
  id                   String              @id @default(cuid())
  name                 String
  country              String
  baseCurrency         String              @default("USD") @map("base_currency")
  logoUrl              String?             @map("logo_url")
  settings             Json                @default("{}")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  departments          Department[]
  users                User[]
  expenseCategories    ExpenseCategory[]
  approvalRules        ApprovalRule[]
  auditLogs            AuditLog[]

  @@map("companies")
}

model Department {
  id                   String              @id @default(cuid())
  companyId            String              @map("company_id")
  name                 String
  code                 String?
  parentId             String?             @map("parent_id")
  managerId            String?             @map("manager_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent               Department?         @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children             Department[]        @relation("DepartmentHierarchy")
  manager              User?               @relation("DepartmentManager", fields: [managerId], references: [id])
  users                User[]              @relation("UserDepartment")
  approvalRules        ApprovalRule[]

  @@unique([companyId, code])
  @@map("departments")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FINANCE
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model User {
  id                   String              @id @default(cuid())
  companyId            String              @map("company_id")
  departmentId         String?             @map("department_id")
  employeeCode         String?             @map("employee_code")
  email                String              @unique
  passwordHash         String              @map("password_hash")
  firstName            String              @map("first_name")
  lastName             String              @map("last_name")
  position             String?
  role                 UserRole            @default(EMPLOYEE)
  status               UserStatus          @default(PENDING)
  phone                String?
  avatarUrl            String?             @map("avatar_url")
  reportsToId          String?             @map("reports_to_id")
  monthlyBudget        Decimal?            @map("monthly_budget") @db.Decimal(12, 2)
  approvalLimit        Decimal?            @map("approval_limit") @db.Decimal(12, 2)
  isVipApprover        Boolean             @default(false) @map("is_vip_approver")
  isRequiredApprover   Boolean             @default(false) @map("is_required_approver")
  refreshToken         String?             @map("refresh_token")
  resetToken           String?             @map("reset_token")
  resetTokenExpiry     DateTime?           @map("reset_token_expiry")
  lastLoginAt          DateTime?           @map("last_login_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department           Department?         @relation("UserDepartment", fields: [departmentId], references: [id])
  reportsTo            User?               @relation("ReportingHierarchy", fields: [reportsToId], references: [id])
  directReports        User[]              @relation("ReportingHierarchy")
  managedDepartments   Department[]        @relation("DepartmentManager")
  expenses             Expense[]           @relation("ExpenseCreator")
  expenseComments      ExpenseComment[]
  approvalSteps        ApprovalStep[]      @relation("Approver")
  approvalRuleApprovers ApprovalRuleApprover[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@index([companyId])
  @@index([email])
  @@map("users")
}

// ============================================================================
// EXPENSE CATEGORIES
// ============================================================================

model ExpenseCategory {
  id                   String              @id @default(cuid())
  companyId            String              @map("company_id")
  name                 String
  code                 String
  description          String?
  parentId             String?             @map("parent_id")
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent               ExpenseCategory?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children             ExpenseCategory[]   @relation("CategoryHierarchy")
  expenses             Expense[]
  expenseLines         ExpenseLine[]

  @@unique([companyId, code])
  @@map("expense_categories")
}

// ============================================================================
// EXPENSES
// ============================================================================

enum ExpenseStatus {
  DRAFT
  TO_SUBMIT
  SUBMITTED
  APPROVED
  REJECTED
  DONE
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  IN_PAYMENT
  PAID
}

model Expense {
  id                   String              @id @default(cuid())
  companyId            String              @map("company_id")
  creatorId            String              @map("creator_id")
  categoryId           String?             @map("category_id")
  title                String
  description          String?
  totalAmount          Decimal             @map("total_amount") @db.Decimal(12, 2)
  currency             String              @default("USD")
  convertedAmount      Decimal?            @map("converted_amount") @db.Decimal(12, 2)
  exchangeRate         Decimal?            @map("exchange_rate") @db.Decimal(18, 8)
  expenseDate          DateTime            @map("expense_date")
  status               ExpenseStatus       @default(DRAFT)
  paymentStatus        PaymentStatus       @default(UNPAID) @map("payment_status")
  submittedAt          DateTime?           @map("submitted_at")
  approvedAt           DateTime?           @map("approved_at")
  rejectedAt           DateTime?           @map("rejected_at")
  paidAt               DateTime?           @map("paid_at")
  checksum             String?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  creator              User                @relation("ExpenseCreator", fields: [creatorId], references: [id])
  category             ExpenseCategory?    @relation(fields: [categoryId], references: [id])
  expenseLines         ExpenseLine[]
  receipts             Receipt[]
  comments             ExpenseComment[]
  approvalSteps        ApprovalStep[]

  @@index([companyId])
  @@index([creatorId])
  @@index([status])
  @@map("expenses")
}

model ExpenseLine {
  id                   String              @id @default(cuid())
  expenseId            String              @map("expense_id")
  categoryId           String?             @map("category_id")
  description          String
  amount               Decimal             @db.Decimal(12, 2)
  currency             String              @default("USD")
  vendor               String?
  lineDate             DateTime            @map("line_date")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  expense              Expense             @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  category             ExpenseCategory?    @relation(fields: [categoryId], references: [id])
  receipts             Receipt[]

  @@index([expenseId])
  @@map("expense_lines")
}

// ============================================================================
// RECEIPTS & OCR
// ============================================================================

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Receipt {
  id                   String              @id @default(cuid())
  expenseId            String              @map("expense_id")
  expenseLineId        String?             @map("expense_line_id")
  fileName             String              @map("file_name")
  filePath             String              @map("file_path")
  fileSize             Int                 @map("file_size")
  mimeType             String              @map("mime_type")
  ocrStatus            OcrStatus           @default(PENDING) @map("ocr_status")
  ocrData              Json?               @map("ocr_data")
  ocrRawText           String?             @map("ocr_raw_text")
  checksum             String?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  expense              Expense             @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseLine          ExpenseLine?        @relation(fields: [expenseLineId], references: [id])

  @@index([expenseId])
  @@map("receipts")
}

// ============================================================================
// COMMENTS (Threaded)
// ============================================================================

enum CommentType {
  MESSAGE
  LOG_NOTE
  SYSTEM
}

model ExpenseComment {
  id                   String              @id @default(cuid())
  expenseId            String              @map("expense_id")
  authorId             String              @map("author_id")
  parentId             String?             @map("parent_id")
  content              String
  commentType          CommentType         @default(MESSAGE) @map("comment_type")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  expense              Expense             @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  author               User                @relation(fields: [authorId], references: [id])
  parent               ExpenseComment?     @relation("CommentThread", fields: [parentId], references: [id])
  replies              ExpenseComment[]    @relation("CommentThread")

  @@index([expenseId])
  @@map("expense_comments")
}

// ============================================================================
// APPROVAL ENGINE
// ============================================================================

enum ApprovalType {
  SEQUENTIAL
  PERCENTAGE
  ANY
}

model ApprovalRule {
  id                   String              @id @default(cuid())
  companyId            String              @map("company_id")
  departmentId         String?             @map("department_id")
  name                 String
  description          String?
  approvalType         ApprovalType        @default(SEQUENTIAL) @map("approval_type")
  percentageRequired   Int?                @map("percentage_required")
  minAmount            Decimal?            @map("min_amount") @db.Decimal(12, 2)
  maxAmount            Decimal?            @map("max_amount") @db.Decimal(12, 2)
  isActive             Boolean             @default(true) @map("is_active")
  priority             Int                 @default(0)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department           Department?         @relation(fields: [departmentId], references: [id])
  approvers            ApprovalRuleApprover[]

  @@index([companyId])
  @@map("approval_rules")
}

model ApprovalRuleApprover {
  id                   String              @id @default(cuid())
  ruleId               String              @map("rule_id")
  userId               String              @map("user_id")
  sequence             Int
  isRequired           Boolean             @default(false) @map("is_required")
  createdAt            DateTime            @default(now()) @map("created_at")

  rule                 ApprovalRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user                 User                @relation(fields: [userId], references: [id])

  @@unique([ruleId, userId])
  @@index([ruleId])
  @@map("approval_rule_approvers")
}

enum ApprovalAction {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model ApprovalStep {
  id                   String              @id @default(cuid())
  expenseId            String              @map("expense_id")
  approverId           String              @map("approver_id")
  sequence             Int
  action               ApprovalAction      @default(PENDING)
  comment              String?
  actionAt             DateTime?           @map("action_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  expense              Expense             @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  approver             User                @relation("Approver", fields: [approverId], references: [id])

  @@unique([expenseId, approverId])
  @@index([expenseId])
  @@map("approval_steps")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

enum NotificationType {
  EXPENSE_SUBMITTED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  APPROVAL_REQUIRED
  PAYMENT_PROCESSED
  COMMENT_ADDED
  SYSTEM
}

model Notification {
  id                   String              @id @default(cuid())
  userId               String              @map("user_id")
  type                 NotificationType
  title                String
  message              String
  data                 Json?
  isRead               Boolean             @default(false) @map("is_read")
  readAt               DateTime?           @map("read_at")
  createdAt            DateTime            @default(now()) @map("created_at")

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SUBMIT
  APPROVE
  REJECT
  PAYMENT
}

model AuditLog {
  id                   String              @id @default(cuid())
  companyId            String              @map("company_id")
  userId               String?             @map("user_id")
  action               AuditAction
  entityType           String              @map("entity_type")
  entityId             String              @map("entity_id")
  oldData              Json?               @map("old_data")
  newData              Json?               @map("new_data")
  ipAddress            String?             @map("ip_address")
  userAgent            String?             @map("user_agent")
  createdAt            DateTime            @default(now()) @map("created_at")

  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                 User?               @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
